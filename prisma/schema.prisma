// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum ApplicationStatus {
  Wishlist
  Preparing
  Applied
  OnlineAssessment   @map("Online Assessment")
  TechnicalInterview  @map("Technical Interview")
  HRInterview        @map("HR Interview")
  FinalInterview     @map("Final Interview")
  OfferReceived      @map("Offer Received")
  OfferAccepted      @map("Offer Accepted")
  OfferDeclined      @map("Offer Declined")
  Rejected
  Withdrawn
  Archived
}

enum ReminderPriority {
  Low
  Medium
  High
  Critical
}

enum ReminderStatus {
  Pending
  Completed
  Overdue
}

enum ReminderType {
  FollowUp           @map("Follow-up")
  Interview
  Assessment
  DocumentSubmission @map("Document Submission")
  OfferDeadline      @map("Offer Deadline")
  Personal
  Other
}

enum InterviewStatus {
  Scheduled
  Completed
  Cancelled
  Rescheduled
  NoShow             @map("No Show")
}

enum InterviewResult {
  Pending
  Passed
  Failed
  Waiting
  Selected
}

enum InterviewType {
  Online
  Offline
  Phone
  Video
}

enum NotificationStatus {
  Unread
  Read
}

enum NotificationType {
  Welcome
  ApplicationCreated @map("Application Created")
  ApplicationUpdated @map("Application Updated")
  InterviewScheduled @map("Interview Scheduled")
  InterviewToday     @map("Interview Today")
  ReminderDue        @map("Reminder Due")
  ReminderOverdue    @map("Reminder Overdue")
  SystemAnnouncement @map("System Announcement")
}

enum FeedbackStatus {
  Submitted
  UnderReview        @map("Under Review")
  Planned
  Completed
  Closed
}

enum FeedbackCategory {
  BugReport          @map("Bug Report")
  FeatureRequest     @map("Feature Request")
  ImprovementSuggestion @map("Improvement Suggestion")
  GeneralFeedback    @map("General Feedback")
}

enum JobType {
  FullTime           @map("Full Time")
  Internship
  PartTime           @map("Part Time")
  Contract
  Freelance
}

enum WorkMode {
  Remote
  Hybrid
  OnSite             @map("On-site")
}

// --- MODELS ---

model User {
  id           String    @id @default(uuid()) @db.Uuid
  clerkId      String?   @unique @map("clerk_id") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  role         String    @default("user") @db.VarChar(50)
  isSuspended  Boolean   @default(false) @map("is_suspended")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp

  profile                  Profile?
  resumes                  Resume[]
  applications             Application[]
  reminders                Reminder[]
  feedback                 Feedback[]
  notifications            Notification[]
  subscription             Subscription?
  usageCounters            UsageCounter[]
  aiUsages                 AIUsage[]
  billingHistories         BillingHistory[]
  aiHistories              AIHistory[]

  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  fullName          String   @map("full_name") @db.VarChar(100)
  profileImageUrl   String?  @map("profile_image_url") @db.Text
  phone             String?  @db.VarChar(20)
  college           String?  @db.VarChar(150)
  degree            String?  @db.VarChar(100)
  specialization    String?  @db.VarChar(100)
  graduationYear    Int?     @map("graduation_year")
  preferredRole     String?  @map("preferred_role") @db.VarChar(100)
  preferredLocation  String?  @map("preferred_location") @db.VarChar(100)
  bio               String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Resume {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(100)
  targetRole   String?       @map("target_role") @db.VarChar(100)
  version      String?       @db.VarChar(30)
  fileUrl      String        @map("file_url") @db.Text
  fileSize     Int           @map("file_size")
  notes        String?       @db.Text
  isDefault    Boolean       @default(false) @map("is_default")
  rawText      String?       @map("raw_text") @db.Text
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamp
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("resumes")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  resumeId        String            @map("resume_id") @db.Uuid
  companyName     String            @map("company_name") @db.VarChar(150)
  jobTitle        String            @map("job_title") @db.VarChar(150)
  department      String?           @db.VarChar(100)
  jobType         JobType           @map("job_type")
  workMode        WorkMode          @map("work_mode")
  location        String?           @db.VarChar(100)
  source          String            @db.VarChar(100)
  recruiterName   String?           @map("recruiter_name") @db.VarChar(100)
  recruiterEmail  String?           @map("recruiter_email") @db.VarChar(255)
  salary          Decimal?          @db.Decimal(12, 2)
  jobUrl          String?           @map("job_url") @db.Text
  notes           String?           @db.Text
  currentStatus   ApplicationStatus @map("current_status")
  applicationDate DateTime          @map("application_date") @db.Date
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamp
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume            @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  interviews      Interview[]
  statusHistory   ApplicationStatusHistory[]
  reminders       Reminder[]

  @@index([userId])
  @@index([resumeId])
  @@index([companyName])
  @@index([currentStatus])
  @@index([userId, currentStatus])
  @@index([applicationDate])
  @@index([source])
  @@index([deletedAt])
  @@map("applications")
}

model ApplicationStatusHistory {
  id             String            @id @default(uuid()) @db.Uuid
  applicationId  String            @map("application_id") @db.Uuid
  previousStatus ApplicationStatus? @map("previous_status")
  newStatus      ApplicationStatus @map("new_status")
  changedAt      DateTime          @default(now()) @map("changed_at") @db.Timestamp
  notes          String?           @db.Text

  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([changedAt])
  @@map("application_status_history")
}

model Interview {
  id                String          @id @default(uuid()) @db.Uuid
  applicationId     String          @map("application_id") @db.Uuid
  interviewRound    String          @map("interview_round") @db.VarChar(100)
  interviewType     InterviewType   @map("interview_type")
  status            InterviewStatus @map("interview_status")
  result            InterviewResult @map("interview_result")
  interviewerName   String?         @map("interviewer_name") @db.VarChar(100)
  interviewerEmail  String?         @map("interviewer_email") @db.VarChar(255)
  meetingPlatform   String?         @map("meeting_platform") @db.VarChar(100)
  meetingLink       String?         @map("meeting_link") @db.Text
  scheduledDate     DateTime        @map("scheduled_date") @db.Date
  scheduledTime     DateTime        @map("scheduled_time") @db.Time(0)
  timeZone          String          @map("timezone") @db.VarChar(100)
  preparationNotes  String?         @map("preparation_notes") @db.Text
  interviewFeedback String?         @map("interview_feedback") @db.Text
  questionsAsked    String?         @map("questions_asked") @db.Text
  personalNotes     String?         @map("personal_notes") @db.Text
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamp
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamp

  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reminders         Reminder[]

  @@index([applicationId])
  @@index([scheduledDate])
  @@index([status])
  @@index([deletedAt])
  @@map("interviews")
}

model Reminder {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  applicationId String?          @map("application_id") @db.Uuid
  interviewId   String?          @map("interview_id") @db.Uuid
  title         String           @db.VarChar(150)
  description   String?          @db.Text
  reminderType  ReminderType     @map("reminder_type")
  priority      ReminderPriority
  status        ReminderStatus
  dueDate       DateTime         @map("due_date") @db.Date
  dueTime       DateTime?        @map("due_time") @db.Time(0)
  completedAt   DateTime?        @map("completed_at") @db.Timestamp
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamp
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview     Interview?       @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([interviewId])
  @@index([dueDate])
  @@index([priority])
  @@index([status])
  @@index([userId, status])
  @@index([deletedAt])
  @@map("reminders")
}

model Feedback {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  category      FeedbackCategory
  title         String           @db.VarChar(150)
  description   String           @db.Text
  screenshotUrl String?          @map("screenshot_url") @db.Text
  status        FeedbackStatus
  adminNotes    String?          @map("admin_notes") @db.Text
  appVersion    String           @map("app_version") @db.VarChar(30)
  browser       String           @db.VarChar(100)
  device        String           @db.VarChar(100)
  submittedAt   DateTime         @default(now()) @map("submitted_at") @db.Timestamp
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([submittedAt])
  @@map("feedback")
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  type             NotificationType
  title            String             @db.VarChar(150)
  message          String             @db.Text
  status           NotificationStatus
  relatedEntity    String?            @map("related_entity") @db.VarChar(50)
  relatedEntityId  String?            @map("related_entity_id") @db.Uuid
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamp
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp
  readAt           DateTime?          @map("read_at") @db.Timestamp
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamp

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  details    String?  @db.Text
  timestamp  DateTime @default(now()) @db.Timestamp

  @@map("audit_logs")
}

// --- SUBSCRIPTION SYSTEM ---

enum PlanType {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BillingStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum FeatureType {
  APPLICATIONS
  RESUMES
  INTERVIEWS
  REMINDERS
  STORAGE
  AI_ANALYSIS
  AI_MATCH
  AI_REWRITE
  AI_COVER_LETTER
  AI_INTERVIEW
  CAREER_INSIGHTS
  AI_JOB_FIT
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @unique @map("user_id") @db.Uuid
  plan         PlanType           @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)
  startsAt     DateTime           @default(now()) @map("starts_at") @db.Timestamp
  expiresAt    DateTime?          @map("expires_at") @db.Timestamp
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamp
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamp
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamp

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingHistories BillingHistory[]

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([deletedAt])
  @@map("subscriptions")
}

model UsageCounter {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  feature     FeatureType
  used        Int         @default(0)
  limit       Int
  periodStart DateTime    @default(now()) @map("period_start") @db.Timestamp
  periodEnd   DateTime?   @map("period_end") @db.Timestamp
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamp
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamp

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@index([feature])
  @@index([deletedAt])
  @@map("usage_counters")
}

model PlanDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  plan         PlanType @unique
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice  Decimal  @map("yearly_price") @db.Decimal(12, 2)
  configuration Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@map("plan_definitions")
}

model AIUsage {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  feature      FeatureType
  requestCount Int         @default(0) @map("request_count")
  tokensUsed   Int         @default(0) @map("tokens_used")
  estimatedCost Decimal    @default(0) @map("estimated_cost") @db.Decimal(10, 4)
  lastUsedAt   DateTime    @default(now()) @map("last_used_at") @db.Timestamp
  month        Int
  year         Int
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamp

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, month, year])
  @@index([userId])
  @@index([month, year])
  @@map("ai_usages")
}

model BillingHistory {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.VarChar(10)
  plan              PlanType?
  billingCycle      BillingCycle? @map("billing_cycle")
  status            BillingStatus @default(PENDING)
  paymentMethod     String?       @map("payment_method") @db.VarChar(50)
  razorpayOrderId   String?       @map("razorpay_order_id") @db.VarChar(255)
  razorpayPaymentId String?       @map("razorpay_payment_id") @db.VarChar(255)
  razorpaySignature String?       @map("razorpay_signature") @db.VarChar(255)
  invoiceNumber     String?       @map("invoice_number") @db.VarChar(100)
  receiptNumber     String?       @map("receipt_number") @db.VarChar(100)
  paidAt            DateTime?     @map("paid_at") @db.Timestamp
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamp
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([deletedAt])
  @@map("billing_histories")
}

model AIHistory {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  feature         FeatureType
  inputHash       String      @map("input_hash") @db.VarChar(64)
  requestPayload  Json        @map("request_payload")
  responsePayload Json        @map("response_payload")
  executionTime   Int         @map("execution_time")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, inputHash])
  @@index([userId])
  @@index([inputHash])
  @@map("ai_histories")
}
