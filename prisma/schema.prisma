// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum ApplicationStatus {
  Wishlist
  Preparing
  Applied
  OnlineAssessment   @map("Online Assessment")
  TechnicalInterview  @map("Technical Interview")
  HRInterview        @map("HR Interview")
  FinalInterview     @map("Final Interview")
  OfferReceived      @map("Offer Received")
  OfferAccepted      @map("Offer Accepted")
  OfferDeclined      @map("Offer Declined")
  Rejected
  Withdrawn
  Archived
}

enum ReminderPriority {
  Low
  Medium
  High
  Critical
}

enum ReminderStatus {
  Pending
  Completed
  Overdue
}

enum ReminderType {
  FollowUp           @map("Follow-up")
  Interview
  Assessment
  DocumentSubmission @map("Document Submission")
  OfferDeadline      @map("Offer Deadline")
  Personal
  Other
}

enum InterviewStatus {
  Scheduled
  Completed
  Cancelled
  Rescheduled
  NoShow             @map("No Show")
}

enum InterviewResult {
  Pending
  Passed
  Failed
  Waiting
  Selected
}

enum InterviewType {
  Online
  Offline
  Phone
  Video
}

enum NotificationStatus {
  Unread
  Read
}

enum NotificationType {
  Welcome
  ApplicationCreated @map("Application Created")
  ApplicationUpdated @map("Application Updated")
  InterviewScheduled @map("Interview Scheduled")
  InterviewToday     @map("Interview Today")
  ReminderDue        @map("Reminder Due")
  ReminderOverdue    @map("Reminder Overdue")
  SystemAnnouncement @map("System Announcement")
}

enum FeedbackStatus {
  Submitted
  UnderReview        @map("Under Review")
  Planned
  Completed
  Closed
}

enum FeedbackCategory {
  BugReport          @map("Bug Report")
  FeatureRequest     @map("Feature Request")
  ImprovementSuggestion @map("Improvement Suggestion")
  GeneralFeedback    @map("General Feedback")
}

enum JobType {
  FullTime           @map("Full Time")
  Internship
  PartTime           @map("Part Time")
  Contract
  Freelance
}

enum WorkMode {
  Remote
  Hybrid
  OnSite             @map("On-site")
}

// --- MODELS ---

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp

  profile                  Profile?
  resumes                  Resume[]
  applications             Application[]
  reminders                Reminder[]
  feedback                 Feedback[]
  notifications            Notification[]

  @@map("users")
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  fullName          String   @map("full_name") @db.VarChar(100)
  profileImageUrl   String?  @map("profile_image_url") @db.Text
  phone             String?  @db.VarChar(20)
  college           String?  @db.VarChar(150)
  degree            String?  @db.VarChar(100)
  specialization    String?  @db.VarChar(100)
  graduationYear    Int?     @map("graduation_year")
  preferredRole     String?  @map("preferred_role") @db.VarChar(100)
  preferredLocation  String?  @map("preferred_location") @db.VarChar(100)
  bio               String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Resume {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(100)
  targetRole   String?       @map("target_role") @db.VarChar(100)
  version      String?       @db.VarChar(30)
  fileUrl      String        @map("file_url") @db.Text
  fileSize     Int           @map("file_size")
  notes        String?       @db.Text
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@index([isDefault])
  @@map("resumes")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  resumeId        String            @map("resume_id") @db.Uuid
  companyName     String            @map("company_name") @db.VarChar(150)
  jobTitle        String            @map("job_title") @db.VarChar(150)
  department      String?           @db.VarChar(100)
  jobType         JobType           @map("job_type")
  workMode        WorkMode          @map("work_mode")
  location        String?           @db.VarChar(100)
  source          String            @db.VarChar(100)
  recruiterName   String?           @map("recruiter_name") @db.VarChar(100)
  recruiterEmail  String?           @map("recruiter_email") @db.VarChar(255)
  salary          Decimal?          @db.Decimal(12, 2)
  jobUrl          String?           @map("job_url") @db.Text
  notes           String?           @db.Text
  currentStatus   ApplicationStatus @map("current_status")
  applicationDate DateTime          @map("application_date") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume            @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  interviews      Interview[]
  statusHistory   ApplicationStatusHistory[]
  reminders       Reminder[]

  @@index([userId])
  @@index([resumeId])
  @@index([companyName])
  @@index([currentStatus])
  @@index([applicationDate])
  @@index([source])
  @@map("applications")
}

model ApplicationStatusHistory {
  id             String            @id @default(uuid()) @db.Uuid
  applicationId  String            @map("application_id") @db.Uuid
  previousStatus ApplicationStatus? @map("previous_status")
  newStatus      ApplicationStatus @map("new_status")
  changedAt      DateTime          @default(now()) @map("changed_at") @db.Timestamp
  notes          String?           @db.Text

  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([changedAt])
  @@map("application_status_history")
}

model Interview {
  id                String          @id @default(uuid()) @db.Uuid
  applicationId     String          @map("application_id") @db.Uuid
  interviewRound    String          @map("interview_round") @db.VarChar(100)
  interviewType     InterviewType   @map("interview_type")
  status            InterviewStatus @map("interview_status")
  result            InterviewResult @map("interview_result")
  interviewerName   String?         @map("interviewer_name") @db.VarChar(100)
  interviewerEmail  String?         @map("interviewer_email") @db.VarChar(255)
  meetingPlatform   String?         @map("meeting_platform") @db.VarChar(100)
  meetingLink       String?         @map("meeting_link") @db.Text
  scheduledDate     DateTime        @map("scheduled_date") @db.Date
  scheduledTime     DateTime        @map("scheduled_time") @db.Time(0)
  timeZone          String          @map("timezone") @db.VarChar(100)
  preparationNotes  String?         @map("preparation_notes") @db.Text
  interviewFeedback String?         @map("interview_feedback") @db.Text
  questionsAsked    String?         @map("questions_asked") @db.Text
  personalNotes     String?         @map("personal_notes") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamp

  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reminders         Reminder[]

  @@index([applicationId])
  @@index([scheduledDate])
  @@index([status])
  @@map("interviews")
}

model Reminder {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  applicationId String?          @map("application_id") @db.Uuid
  interviewId   String?          @map("interview_id") @db.Uuid
  title         String           @db.VarChar(150)
  description   String?          @db.Text
  reminderType  ReminderType     @map("reminder_type")
  priority      ReminderPriority
  status        ReminderStatus
  dueDate       DateTime         @map("due_date") @db.Date
  dueTime       DateTime?        @map("due_time") @db.Time(0)
  completedAt   DateTime?        @map("completed_at") @db.Timestamp
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview     Interview?       @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([interviewId])
  @@index([dueDate])
  @@index([priority])
  @@index([status])
  @@map("reminders")
}

model Feedback {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  category      FeedbackCategory
  title         String           @db.VarChar(150)
  description   String           @db.Text
  screenshotUrl String?          @map("screenshot_url") @db.Text
  status        FeedbackStatus
  appVersion    String           @map("app_version") @db.VarChar(30)
  browser       String           @db.VarChar(100)
  device        String           @db.VarChar(100)
  submittedAt   DateTime         @default(now()) @map("submitted_at") @db.Timestamp
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([submittedAt])
  @@map("feedback")
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  type             NotificationType
  title            String             @db.VarChar(150)
  message          String             @db.Text
  status           NotificationStatus
  relatedEntity    String?            @map("related_entity") @db.VarChar(50)
  relatedEntityId  String?            @map("related_entity_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp
  readAt           DateTime?          @map("read_at") @db.Timestamp
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamp

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}
